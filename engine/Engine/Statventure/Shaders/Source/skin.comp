#version 460
// GPU skinning, pass 1 (Docs/Renderer-3D.md, "GPU skinning"): each vertex moved by its four joints'
// matrices blended by its weights (linear blend skinning, as glTF and Blender's Armature modifier).
// Normals are recomputed from the moved surface in pass 2 (normals.comp).
#include "common.glsl"
struct MeshVertex { vec3 position; vec3 normal; vec2 uv; };
layout(buffer_reference, scalar) readonly buffer MeshVertices { MeshVertex items[]; };

layout(local_size_x = 64) in;

struct SkinVertex { uint joints01; uint joints23; vec4 weights; };
layout(buffer_reference, scalar) readonly buffer SkinVertices { SkinVertex items[]; };
layout(buffer_reference, scalar) readonly buffer JointMatrices { mat4 items[]; };
layout(buffer_reference, scalar) writeonly buffer OutVertices { MeshVertex items[]; };
layout(push_constant, scalar) uniform SkinPush { MeshVertices rest; SkinVertices skin; JointMatrices joints; OutVertices posed; uint count; } skinning;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= skinning.count)
        return;
    MeshVertex v = skinning.rest.items[i];
    SkinVertex s = skinning.skin.items[i];
    // Matrices as System.Numerics uploads them (row vectors), so M * v here is v * M there.
    mat4 m = s.weights.x * skinning.joints.items[s.joints01 & 0xffffu]
        + s.weights.y * skinning.joints.items[s.joints01 >> 16]
        + s.weights.z * skinning.joints.items[s.joints23 & 0xffffu]
        + s.weights.w * skinning.joints.items[s.joints23 >> 16];
    MeshVertex o;
    o.position = (m * vec4(v.position, 1.0)).xyz;
    o.normal = v.normal;
    o.uv = v.uv;
    skinning.posed.items[i] = o;
}
