<Project Sdk="Microsoft.NET.Sdk">
  <!-- Engine tests: unit tests, and headless GPU tests that compare renders with golden images. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../Engine/Statventure/Statventure.csproj" />
    <!-- The editor (M11, P1): its tests are in Editor/. -->
    <ProjectReference Include="../../Tools/Editor/Editor.csproj" />
    <!-- The game's data library (M12 step 6): built before the tests, which load it as the editor does, from its build in
         the repo or copies of it in scratch game folders, never as a reference of their own (the engine keeps one record
         kind per name for the process: the editor's loader is the only way in). -->
    <ProjectReference Include="../../Game/Statventure.Game.Data/Statventure.Game.Data.csproj" ReferenceOutputAssembly="false" />
    <!-- The packer, built before the tests that run it (the game's kinds in its dumps, M12 step 6). -->
    <ProjectReference Include="../../Tools/Packer/Packer.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UiBenchmark" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <None Include="Golden/**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Data/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
