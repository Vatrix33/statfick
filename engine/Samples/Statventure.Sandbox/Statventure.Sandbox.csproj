<Project Sdk="Microsoft.NET.Sdk">
  <!-- A visual test bed for the engine. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Statventure.Sandbox</RootNamespace>
  </PropertyGroup>
  <!-- A runtime publish (Tools/Scripts/publish.sh, publish.ps1; Docs/Packaging.md, "Building them"): self-contained
       (M12-3), one single-file program with the native libraries beside it (Q5), not trimmed (M12-3: the record system
       finds its kinds by reflection), a GUI program on Windows, no console (Q6). The symbols are embedded with paths from
       the repo's root (Q7) for every assembly of the program, the engine's too, so the publish passes those as global
       properties (DebugType=embedded, ContinuousIntegrationBuild=true). Builds without a runtime (build.sh's dev
       layout, the tests) stay as they are. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <OutputType Condition="$(RuntimeIdentifier.StartsWith('win'))">WinExe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Engine/Statventure/Statventure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The game's fonts (as the tests use them). -->
    <None Include="../../Tests/Statventure.Tests/Data/Fonts/**" LinkBase="Data/Fonts" CopyToOutputDirectory="PreserveNewest" />
    <!-- Ji'ruan's intro, the M10 proof (Cutscene.cs): test data, as the tests use it (Docs/Scene.md, Q30). -->
    <None Include="../../Tests/Statventure.Tests/Data/Cutscenes/**" LinkBase="Data/Cutscenes" CopyToOutputDirectory="PreserveNewest" />
    <!-- The game's music in packs/ beside it, where the game mounts its packs: the proof's theme (S7-6). -->
    <None Include="../../Assets/Packs/audio.pak" Link="packs/audio.pak" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../Tests/Statventure.Tests/Data/Models/jiruan.glb;../../Tests/Statventure.Tests/Data/Models/jiruan-acting.glb;../../Tests/Statventure.Tests/Data/Models/figure.glb" LinkBase="Data/Models" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
