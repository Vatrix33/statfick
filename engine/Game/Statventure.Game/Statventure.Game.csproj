<Project Sdk="Microsoft.NET.Sdk">
  <!-- The game's program (GM1-P1; Docs/Game/Foundation.md, "The program, the library and the repo"): Stat Fick on the
       Statventure engine, published as stat-fick and "Stat Fick.exe" (M12-2: Tools/Packaging/Publish.cs renames the
       executable) and laid out by build.sh in $STATVENTURE_GAME. Its files are taken by the SDK's wildcards: the
       application class and its seams are at the root and in Sounds/; each part's folder (Settings/, Session/, Random/,
       Mods/, Icons/, Ui/, Screens/<screen>/) is the step's that fills it ("The seams"), which adds and changes files there
       only. Its tests are Tests/Statventure.Game.Tests (GM1-P4). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Statventure.Game</RootNamespace>
    <AssemblyName>Statventure.Game</AssemblyName>
  </PropertyGroup>
  <!-- A runtime publish (Tools/Scripts/publish.sh, publish.ps1; Docs/Packaging.md, "Building them"): self-contained
       (M12-3), one single-file program with the native libraries beside it (Q5), not trimmed (M12-3: the record system
       finds its kinds by reflection), a GUI program on Windows, no console (Q6). The symbols are embedded with paths from
       the repo's root (Q7) for every assembly of the program, the engine's too, so the publish passes those as global
       properties (DebugType=embedded, ContinuousIntegrationBuild=true). Builds without a runtime (build.sh's dev
       layout, the tests) stay as they are. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <OutputType Condition="$(RuntimeIdentifier.StartsWith('win'))">WinExe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Engine/Statventure/Statventure.csproj" />
    <!-- The game's data library (M12-9, Q19): the game links it; the editor loads it from the game's folder. -->
    <ProjectReference Include="../Statventure.Game.Data/Statventure.Game.Data.csproj" />
  </ItemGroup>
  <!-- The data library stays a file of its own beside the single-file program (Q5): the editor loads it from the game's
       folder (M12-9, Q19). -->
  <Target Name="KeepTheDataLibraryBeside" BeforeTargets="_ComputeFilesToBundle">
    <ItemGroup>
      <ResolvedFileToPublish Condition="'%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'Statventure.Game.Data.dll'">
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
  <ItemGroup>
    <InternalsVisibleTo Include="Statventure.Game.Tests" />
  </ItemGroup>
</Project>
