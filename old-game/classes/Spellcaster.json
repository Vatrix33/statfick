{
  "id": "spellcaster",
  "name": "Spellcaster",
  "requirements": {
    "level": 1,
    "classes": { "mage": 5 },
    "other": { "type": "stat-comparison", "left": "intelligence", "operator": "greater-than", "right": "wisdom", "description": "Intelligence higher than Wisdom" }
  },
  "maxLevel": 7,
  "levels": [
    { "level": 1, "description": "Increase Intelligence by 5%.", "effects": [{ "type": "stat-permanent-percent", "target": "intelligence", "amount": 5 }] },
    { "level": 2, "description": "Increase Wisdom by 5%.", "effects": [{ "type": "stat-permanent-percent", "target": "wisdom", "amount": 5 }] },
    { "level": 3, "description": "Basic-Element spells deal 5% more damage.", "effects": [{ "type": "spell-damage-percent", "element": "basic", "amount": 5 }] },
    { "level": 4, "description": "Spells cost 5% less to learn.", "effects": [{ "type": "spell-learning-cost-percent", "amount": 5 }] },
    { "level": 5, "description": "Unlock Quickened Spell.", "effects": [{
      "type": "skill", "id": "quickened-spell", "name": "Quickened Spell", "combatOnly": true, "cooldown": "combat", "durationSpells": 1,
      "description": "Your next spell uses 1 fewer Action Point. Can only be used once per combat.",
      "effects": [{ "type": "spell-action-points-flat", "amount": -1 }]
    }] },
    { "level": 6, "description": "Increase Mind by 5%.", "effects": [{ "type": "stat-permanent-percent", "target": "mind", "amount": 5 }] },
    { "level": 7, "description": "Gain the Pure Spells passive.", "effects": [{
      "type": "passive", "id": "pure-spells", "name": "Pure Spells", "condition": "After a turn spent only casting one spell",
      "description": "At the end of your turn, if you cast exactly one spell and did nothing else, refund 25% of that spell's Mana cost.",
      "effects": [{ "type": "single-spell-turn-mana-refund-percent", "amount": 25 }]
    }] }
  ]
}
